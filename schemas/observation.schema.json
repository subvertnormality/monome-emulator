{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "observation",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "backend": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "fidelity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "monotonic_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000000000000000
    },
    "frame_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "grid_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "state": {
      "type": "object"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "backend",
    "fidelity",
    "monotonic_ns",
    "frame_revision",
    "grid_revision",
    "state",
    "errors"
  ],
  "additionalProperties": false
}
