{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "error",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "monotonic_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000000000000000
    }
  },
  "required": [
    "schema_version",
    "code",
    "message",
    "monotonic_ns"
  ],
  "additionalProperties": false
}
