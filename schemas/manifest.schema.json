{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "backend": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "fidelity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "tier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "family": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "clock_mode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "enum": [
        "real-time",
        "controlled"
      ]
    },
    "platform": {
      "type": "object"
    },
    "source": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000000
              }
            },
            "required": [
              "path",
              "sha256",
              "size"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 10000
        }
      },
      "required": [
        "revision",
        "digest",
        "files"
      ],
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        }
      },
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "additionalProperties": false
    },
    "started_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000000000000000
    },
    "finished_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000000000000000
    },
    "collected": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "passed": {
      "type": "boolean"
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "index",
          "kind",
          "passed",
          "detail"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          }
        },
        "required": [
          "path",
          "sha256",
          "size"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "application": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object"
        }
      ]
    },
    "runtime": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object"
        }
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "session_id",
    "backend",
    "fidelity",
    "tier",
    "family",
    "clock_mode",
    "platform",
    "source",
    "scenario",
    "started_ns",
    "finished_ns",
    "collected",
    "passed",
    "exit_code",
    "results",
    "artifacts",
    "application",
    "runtime",
    "error"
  ],
  "additionalProperties": false
}
