{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ack",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "status": {
      "enum": [
        "applied",
        "accepted"
      ]
    },
    "monotonic_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000000000000000
    },
    "native": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "monotonic_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      },
      "required": [
        "sequence",
        "monotonic_ns"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "action_id",
    "sequence",
    "status",
    "monotonic_ns"
  ],
  "additionalProperties": false
}
