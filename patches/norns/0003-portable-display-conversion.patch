+++ b/matron/src/hardware/screen/ssd1322.h
@@ -1,6 +1,8 @@
 #pragma once
 
+#if defined(__ARM_NEON)
 #include <arm_neon.h>
+#endif
 #include <cairo.h>
 #include <fcntl.h>
 #include <gpiod.h>
