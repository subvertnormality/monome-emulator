+
+/* Claim a queued resume before entering Lua. Epoch changes invalidate old sync
+ * events and re-arm their waiting coroutines; sleep deadlines stay independent.
+ * A running coroutine is not re-armed: its next sync rebases by sync_epoch. */
+bool clock_scheduler_claim_resume(int thread_id, bool is_sync, unsigned long long epoch) {
+    bool accepted = false;
+    pthread_mutex_lock(&clock_scheduler_events_lock);
+    for (int i = 0; i < NUM_CLOCK_SCHEDULER_EVENTS; i++) {
+        clock_scheduler_event_t *event = &clock_scheduler_events[i];
+        if (event->thread_id != thread_id) continue;
+        if (event->queued && (!is_sync || epoch == clock_scheduler_epoch)) {
+            event->queued = false;
+            accepted = true;
+        }
+        break;
+    }
+    pthread_mutex_unlock(&clock_scheduler_events_lock);
+    return accepted;
+}
