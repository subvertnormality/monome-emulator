+/* Publish the source reference and Start before a scheduler poll can expose its
+ * new waiters. The callback only publishes C reference data, never executes Lua. */
+void clock_scheduler_begin_source_epoch(bool received_zero, void (*publish)(void *), void *context) {
+    pthread_mutex_lock(&clock_scheduler_events_lock);
+    clock_scheduler_epoch++;
+    if (publish != NULL) publish(context);
+    for (int i = 0; i < NUM_CLOCK_SCHEDULER_EVENTS; i++) {
+        clock_scheduler_event_t *event = &clock_scheduler_events[i];
+        if (event->thread_id < 0 || event->type != CLOCK_SCHEDULER_EVENT_SYNC) continue;
+        event->received_zero = received_zero && event->midi_output;
+        if (event->ready || event->queued) {
+            event->queued = false;
+            event->ready = true;
+            event->sync_epoch = clock_scheduler_epoch;
+            event->sync_clock_beat = 0;
+        }
+    }
+    union event_data *ev = event_data_new(EVENT_CLOCK_START);
+    ev->clock_start.epoch = clock_scheduler_epoch;
+    event_post(ev);
+    pthread_mutex_unlock(&clock_scheduler_events_lock);
+}
+
+bool clock_scheduler_epoch_is_current(unsigned long long epoch) {
+    pthread_mutex_lock(&clock_scheduler_events_lock);
+    bool current = epoch == clock_scheduler_epoch;
+    pthread_mutex_unlock(&clock_scheduler_events_lock);
+    return current;
+}
