@@ -51,6 +54,28 @@ static void emit(uint32_t kind, uint32_t id, const void *data, size_t size) {
     if (written != (ssize_t)(size+16)) { perror("EMU_ERROR output transport"); _exit(70); }
 }

+struct emu_clock_trace_record {
+    uint32_t version,stage,event_type,thread_id;
+    uint64_t ordinal;
+    double target_jack_s,observed_jack_s,resumed_jack_s,target_beat,observed_beat,value;
+    uint64_t tick,skipped;
+};
+_Static_assert(sizeof(struct emu_clock_trace_record)==88,"clock trace wire layout");
+void emu_clock_trace(uint32_t stage,uint32_t event_type,int32_t thread_id,
+    double target_jack_s,double observed_jack_s,double resumed_jack_s,double target_beat,
+    double observed_beat,double value,uint64_t tick,uint64_t skipped) {
+    if (!atomic_load(&clock_trace_enabled)) return;
+    pthread_mutex_lock(&clock_trace_lock);
+    struct emu_clock_trace_record row={
+        .version=1,.stage=stage,.event_type=event_type,.thread_id=(uint32_t)thread_id,
+        .ordinal=atomic_fetch_add(&clock_trace_ordinal,1)+1,
+        .target_jack_s=target_jack_s,.observed_jack_s=observed_jack_s,.resumed_jack_s=resumed_jack_s,
+        .target_beat=target_beat,.observed_beat=observed_beat,.value=value,
+        .tick=tick,.skipped=skipped};
+    emit(26,(uint32_t)row.ordinal,&row,sizeof(row));
+    pthread_mutex_unlock(&clock_trace_lock);
+}
+
 void emu_error(const char *message) {
     if (emu_enabled()) emit(5,0,message ? message : "unknown Lua error",strlen(message ? message : "unknown Lua error"));
