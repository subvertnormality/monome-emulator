* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Preserve mixed upstream line endings in this tested native diff.
/patches/norns/experimental-screen-worker-shutdown.patch -text

# Unified diff context represents blank source lines with one marker space.
/patches/norns/candidates/*.patch whitespace=-blank-at-eol,-blank-at-eof
